{
  "port": 4317,
  "host": "127.0.0.1",
  "unmatchedDefault": "allow",
  "dangerousDefault": "allow",
  "historyLimit": 10,
  "rules": {
    "deny": [
      { "tool": "Bash", "command": "rm -rf\\s+~", "reason": "deleting home directory" }
    ],
    "ask": [
      { "tool": "Write|Edit|MultiEdit", "path": "\\.(env|pem|key)$", "reason": "modifying secrets file" }
    ],
    "allow": [
      { "tool": "Bash", "command": "^\\s*git\\s+add\\b", "reason": "staging is safe" }
    ]
  }
}
