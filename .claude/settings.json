{
  "permissions": {
    "allow": [
      "Bash",
      "PowerShell"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node F:/workspace/CCApproval/src/hook.js",
            "timeout": 30
          }
        ]
      }
    ]
  }
}